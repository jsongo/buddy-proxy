#!/usr/bin/env bash
# buddy - buddy-proxy 用户入口命令
#
# 日常使用：
#   buddy start              启动代理（未运行时）并打开管理页 http://127.0.0.1:8787/ui
#   buddy stop               停止
#   buddy restart            重启
#   buddy status             查看状态
#   buddy logs               跟踪日志
#   buddy cleanup            删除 15 天前的历史日志（保留窗口可用 BUDDY_LOG_KEEP_DAYS 覆盖）；
#                            超过 10MB 的 service.log / proxy.sh.log 顺带 copytruncate 轮转
#   buddy login [provider]   登录上游账号（codebuddy(=workbuddy)/trae/zcode/glm/doubao/mimo/qoder/gemini/antigravity/kimi）
#   buddy ui                 仅打开管理页（必要时先启动）
#   buddy update             更新到最新代码（git pull -> uv sync -> 重启）
#                            工作树有未提交改动会中止，不会覆盖你的改动
#
# 服务化（macOS launchd，登录自启 + 崩溃自动拉起）：
#   buddy service install    注册系统服务
#   buddy service uninstall  移除服务
#   buddy service status     查看服务状态
#
# 一次性安装（把 buddy 放进 PATH，之后任意目录敲 buddy 即可）：
#   buddy install
#
# 环境变量（对 start / service install 生效）：
#   PROXY_HOST（默认 0.0.0.0）、PROXY_PORT（默认 8787）、PROXY_EXTRA_ARGS（附加启动参数）
#   BUDDY_LOG_KEEP_DAYS（cleanup 保留天数，默认 15）

set -euo pipefail

# 仓库根目录：开发态 = 脚本所在目录；通过 `buddy install` 安装后由 wrapper 注入
BUDDY_HOME="${BUDDY_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PROXY_SH="$BUDDY_HOME/proxy.sh"

PROXY_HOST="${PROXY_HOST:-0.0.0.0}"
PROXY_PORT="${PROXY_PORT:-8787}"
# 与 proxy.sh 默认参数保持一致（改这里记得同步 proxy.sh 的 EXTRA_ARGS，反之亦然）
EXTRA_ARGS="${PROXY_EXTRA_ARGS:---desensitize --trae --doubao --dumate --zcode --zcode-start --mimo --qoder --antigravity --kimi --default-provider trae}"

SERVICE_LABEL="com.buddy.proxy"
PLIST="$HOME/Library/LaunchAgents/${SERVICE_LABEL}.plist"
UI_URL="http://127.0.0.1:${PROXY_PORT}/ui"

log() { printf '[buddy] %s\n' "$*"; }

python_bin() {
    if [[ -x "$BUDDY_HOME/.venv/bin/python" ]]; then
        echo "$BUDDY_HOME/.venv/bin/python"
    else
        command -v python3
    fi
}

# ---------------------------------------------------------------------------
# launchd 服务
# ---------------------------------------------------------------------------

svc_loaded() {
    launchctl print "gui/$UID/$SERVICE_LABEL" >/dev/null 2>&1
}

#: 端口上的「野实例」清场：proxy.sh nohup 起的、或上次 bootout 没死透的孤儿。
#:
#: 2026-10-06 实测的「经常挂」根因就是它：野实例占着 ${PROXY_PORT}，launchd
#: KeepAlive 拉起的新进程永远 errno 48 绑不上（service.log 里 388 次 spawn 全灭），
#: 而 wait_healthy 的 /health 探活打在野实例上显示「成功」——等野实例一死，
#: 端口上就什么都没了，服务悄悄整段消失，只能靠手动重启「修复」，过几天又复发。
#: 所以启动前先看端口：占用者是 buddy_proxy 但**不是本 job 的当前进程** → 干掉。
evict_port_squatters() {
    local holder job
    holder="$(lsof -ti tcp:"$PROXY_PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
    [[ -n "$holder" ]] || return 0
    # [:space:] 而非字面 tab：tab 藏在源码里，编辑器一转空格就静默失配
    job="$(launchctl print "gui/$UID/$SERVICE_LABEL" 2>/dev/null | awk '/^[[:space:]]*pid = /{print $3; exit}' || true)"
    [[ "$holder" == "$job" ]] && return 0  # 就是本 job 的进程，交给 kickstart/bootout 流转
    if ps -o command= -p "$holder" 2>/dev/null | grep -q "buddy_proxy"; then
        log "清理占用 ${PROXY_PORT} 的野实例 pid=${holder}（非 launchd job 进程，留着必成 errno 48 死循环）"
        kill -9 "$holder" 2>/dev/null || true
        sleep 0.5
    else
        log "警告: 端口 ${PROXY_PORT} 被非 buddy_proxy 进程占用 pid=$holder:"
        ps -o command= -p "$holder" 2>/dev/null | head -1 || true
    fi
}

svc_start() {
    evict_port_squatters
    if svc_loaded; then
        launchctl kickstart -k "gui/$UID/$SERVICE_LABEL"
    else
        [[ -f "$PLIST" ]] || { log "服务未安装，先执行 buddy service install"; exit 1; }
        launchctl bootstrap "gui/$UID" "$PLIST"
    fi
}

svc_stop() {
    svc_loaded && launchctl bootout "gui/$UID/$SERVICE_LABEL" || true
}

svc_write_plist() {
    local py
    py="$(python_bin)"
    mkdir -p "$(dirname "$PLIST")" "$BUDDY_HOME/logs"
    # shellcheck disable=SC2086  # EXTRA_ARGS 有意按空格拆分
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${SERVICE_LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${py}</string>
        <string>-m</string>
        <string>buddy_proxy</string>
        <string>--host</string>
        <string>${PROXY_HOST}</string>
        <string>--port</string>
        <string>${PROXY_PORT}</string>
        <string>--log-file</string>
        <string>${BUDDY_HOME}/logs/buddy-proxy.jsonl</string>
$(for a in $EXTRA_ARGS; do printf '        <string>%s</string>\n' "$a"; done)
    </array>
    <key>WorkingDirectory</key>
    <string>${BUDDY_HOME}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>${BUDDY_HOME}/src</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${BUDDY_HOME}/logs/service.log</string>
    <key>StandardErrorPath</key>
    <string>${BUDDY_HOME}/logs/service.log</string>
</dict>
</plist>
EOF
}

cmd_service() {
    case "${1:-}" in
        install)
            # 先停掉手动实例，避免端口冲突
            "$PROXY_SH" stop >/dev/null 2>&1 || true
            svc_write_plist
            svc_stop
            launchctl bootstrap "gui/$UID" "$PLIST"
            log "服务已安装并启动: $PLIST"
            log "登录时自启（RunAtLoad）+ 崩溃自动拉起（KeepAlive），日志: $BUDDY_HOME/logs/service.log"
            ;;
        uninstall)
            svc_stop
            rm -f "$PLIST"
            log "服务已移除"
            ;;
        status)
            if svc_loaded; then
                launchctl print "gui/$UID/$SERVICE_LABEL" | grep -E "state|pid" | head -4
            else
                log "服务未安装（plist: ${PLIST}）"
            fi
            ;;
        *)
            log "用法: buddy service install|uninstall|status"
            exit 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# 启动/停止（有服务走 launchd，否则走 proxy.sh 的 pid 管理）
# ---------------------------------------------------------------------------

cmd_start() {
    if [[ -f "$PLIST" ]]; then
        svc_start
    else
        "$PROXY_SH" start
    fi
    # 健康检查失败（启动慢）也要继续打开 UI，不让 set -e 直接退出
    wait_healthy || true
    open_ui
}

cmd_stop() {
    if [[ -f "$PLIST" ]]; then
        svc_stop
        log "服务已停止（重新启动: buddy start）"
    else
        "$PROXY_SH" stop
    fi
}

# bootout 是异步的：launchctl 返回了不代表 job 卸载完、端口释放了。固定 sleep 1
# 撞上旧进程还在收尾就出两种故障（2026-10-06 14:35/14:39 两次 restart 各抖一轮，
# jsonl 里成对 startup 可证）：新进程 bind 不上立刻退场、KeepAlive 再拉一个才稳；
# 以及 wait_healthy 的探活打在**垂死的旧进程**上假成功——它一死服务又没了。
# 所以重启前等两个事实都落地：job 真卸载 + 端口真空闲（带 10s 超时兜底，
# 超时靠 svc_start 里的 evict_port_squatters 强制清场，不让 restart 卡死）。
wait_svc_gone() {
    local i
    for i in $(seq 1 20); do
        if ! svc_loaded && ! port_listening; then
            return 0
        fi
        sleep 0.5
    done
    log "警告: 旧服务 10s 未完全退场（继续启动，端口占用交 evict_port_squatters 清）"
    return 1
}

cmd_restart() {
    if [[ -f "$PLIST" ]]; then
        svc_stop
        wait_svc_gone || true
        svc_start
        wait_healthy
        open_ui
    else
        "$PROXY_SH" restart
        wait_healthy || true
        open_ui
    fi
}

# 目标端口是否真有进程在监听（唯一事实，pid 文件可能滞后/失效）。
port_listening() {
    lsof -ti tcp:"$PROXY_PORT" -sTCP:LISTEN >/dev/null 2>&1
}

# 代理进程是否活着。探活要的是「进程在不在」，而不是「某个瞬间端口能不能连」——
# 启动空窗/瞬时卡慢都会让一次 TCP 探测失败，但进程其实好好的。proxy.sh status 只
# 看 pid 文件、会跨端口误判（A 端口在跑就算 B 端口 running），所以这里认的是
# 「本端口的 buddy_proxy 进程」这个命令行事实：端口在监听，或进程已起但还没 bind。
proxy_running() {
    port_listening && return 0
    pgrep -f "buddy_proxy --host ${PROXY_HOST} --port ${PROXY_PORT}" >/dev/null 2>&1
}

# 单一状态行：health 只在 OK / 无响应 之间变化时刷新，避免 status 里同一行
# 被反复重写成刷屏。返回当前是否健康，调用方据此决定要不要重试。
render_health_line() {
    local healthy="$1"
    local line
    if [[ "$healthy" == "1" ]]; then
        line="health: OK  管理页: $UI_URL"
    else
        line="health: 无响应"
    fi
    if [[ "$line" != "${_LAST_HEALTH_LINE:-}" ]]; then
        printf '%s\n' "$line"
        _LAST_HEALTH_LINE="$line"
    fi
}

# 探测 /health，带 per-try 超时与有限重试。外部拉起代理（绕过 proxy.sh）时
# pid 文件可能滞后于端口监听，且进程是异步起来的，期间端口会拒连——一次探测
# 必然误报「无响应」。只有进程没在跑才立刻下结论，避免把正常启动的代理错杀。
probe_health() {
    local tries="${1:-1}" i
    for ((i=1; i<=tries; i++)); do
        if curl -sf -m 5 -o /dev/null "http://127.0.0.1:${PROXY_PORT}/health"; then
            return 0
        fi
        [[ "$i" -lt "$tries" ]] && sleep 1
    done
    return 1
}

cmd_status() {
    if [[ -f "$PLIST" ]]; then
        cmd_service status
    fi
    "$PROXY_SH" status || true
    if proxy_running; then
        # 进程在跑：给它最多 ~25s（5s 超时 ×5 + 间隔）跨越启动空窗/瞬时卡慢，
        # 不要一上来就报「无响应」吓自己。真死了（不监听也不退）会在重试后仍失败。
        if probe_health 5; then
            render_health_line 1
        else
            render_health_line 0
        fi
    elif probe_health 1; then
        # 端口能通但 proxy.sh 不认这个 pid（多半是手动/外部拉起的实例）：
        # 不算死，健康状态照常显示。
        render_health_line 1
    else
        render_health_line 0
    fi
}

wait_healthy() {
    for _ in $(seq 1 20); do
        if curl -sf -m 5 -o /dev/null "http://127.0.0.1:${PROXY_PORT}/health"; then
            return 0
        fi
        sleep 0.5
    done
    log "警告: /health 20s 内未就绪（查看日志: buddy logs）"
    return 1
}

# ---------------------------------------------------------------------------
# 更新（拉代码 -> 装依赖 -> 重启）
# ---------------------------------------------------------------------------

# 工作树里是否有未提交改动（含未跟踪文件，但不含被忽略的 logs/ .venv/ 等）
tree_dirty() {
    [[ -n "$(git -C "$BUDDY_HOME" status --porcelain 2>/dev/null)" ]]
}

cmd_update() {
    command -v git >/dev/null 2>&1 || { log "没装 git，无法更新"; exit 1; }
    git -C "$BUDDY_HOME" rev-parse --git-dir >/dev/null 2>&1 \
        || { log "$BUDDY_HOME 不是 git 仓库，无法更新（手动下载新版本后重跑 buddy restart）"; exit 1; }

    # 有未提交改动就停下：下面要 pull，脏工作树轻则 pull 失败、重则把别人的
    # 在制品搅在一起。宁可不动，也不要「更新」成一半的状态。
    if tree_dirty; then
        log "工作树有未提交改动，已中止更新（避免覆盖它们）："
        git -C "$BUDDY_HOME" status --short | sed 's/^/  /'
        # 按类型给对应的处理办法。只写 `git stash` 是不够的：脏判定用的是
        # `status --porcelain`（含未跟踪文件），而 `git stash` 默认不收未跟踪
        # 文件——用户照着做完会得到 "No local changes to save"，再跑 update
        # 被同一理由拦住，看起来像卡死。所以未跟踪的另给 -u 或忽略两种出路。
        # 只要有未跟踪文件（`??`），光 `git stash` 就清不干净——它默认不收
        # 未跟踪的，用户照做后会带着同一个 `??` 再被拦一次。所以判据是
        # 「**有没有** `??`」而不是「是不是只有 `??`」：混着改动的场景下
        # `stash -u` 同样管用（已跟踪的也一并收），没有才给普通 stash。
        if git -C "$BUDDY_HOME" status --porcelain | grep -q '^??'; then
            log "改动里含未跟踪文件，git stash 默认收不走它们，改用："
            log "  git -C \"$BUDDY_HOME\" stash -u      # 连未跟踪一起收"
            log "  或者删掉 / 加进 .gitignore 后重跑 buddy update"
        else
            log "处理完再试：git -C \"$BUDDY_HOME\" stash  或提交后重跑 buddy update"
        fi
        exit 1
    fi

    local branch before after
    branch="$(git -C "$BUDDY_HOME" rev-parse --abbrev-ref HEAD)"
    before="$(git -C "$BUDDY_HOME" rev-parse --short HEAD)"

    # ${var} 必须带花括号：变量名后面紧跟中文时，bash 会把多字节字符的首字节
    # 当成变量名的一部分（实测 `"$before，拉取中"` 报 `before\xef: unbound variable`）
    log "当前分支 ${branch} @ ${before}，拉取中…"
    # --ff-only：本地若已有分叉提交就直接报错，不做任何隐式合并/rebase
    if ! git -C "$BUDDY_HOME" pull --ff-only; then
        # 别把失败一口咬定成分叉：远端不可达（断网 / 代理挂了）也走这里，
        # 那种情况提示「本地有分叉」会把人支到错的方向去翻本地历史。
        # 所以先让用户看 git 自己的报错，分叉只作为其中一种可能提一句。
        # 两种情况照 git 的**原话**给（实测原文，别改写，否则对不上屏幕上的报错）：
        #   分叉     -> fatal: Not possible to fast-forward, aborting.
        #   连不上   -> fatal: Could not read from remote repository.
        log "git pull 失败（原因见上面的 git 报错），已中止更新"
        log "  出现 Not possible to fast-forward：本地有分叉提交，需手动处理"
        log "  出现 Could not read from remote ：网络/代理/远端地址问题"
        exit 1
    fi
    after="$(git -C "$BUDDY_HOME" rev-parse --short HEAD)"

    if [[ "$before" == "$after" ]]; then
        log "代码已是最新（${after}），仍继续同步依赖并重启"
    else
        log "已更新 $before -> $after"
    fi

    if command -v uv >/dev/null 2>&1; then
        log "同步依赖（uv sync）…"
        # 在仓库目录里跑：uv 靠 pyproject.toml/uv.lock 定位项目
        ( cd "$BUDDY_HOME" && uv sync ) || { log "uv sync 失败，已中止（服务未重启）"; exit 1; }
    else
        log "未找到 uv，跳过依赖同步（若报缺包请手动 uv sync）"
    fi

    log "重启服务…"
    cmd_restart
}

# ---------------------------------------------------------------------------
# 清理旧日志（按天轮删带 .YYYY-MM-DD 后缀的历史文件）
# ---------------------------------------------------------------------------

# 应用层按天滚动出 buddy-proxy.jsonl.2026-09-08 / metrics.jsonl.* / proxy.log.*
# 这类历史文件；只增不删会长到几百 M（实测 405M，9 月一个月）。这里按保留窗口
# 删旧的，保留窗口默认 15 天，可用 BUDDY_LOG_KEEP_DAYS 覆盖。
#
# **只删带日期后缀的轮转文件**，不碰当前活跃的 buddy-proxy.jsonl（正在写、
# 没有日期后缀）——判据是文件名尾部严格匹配 .YYYY-MM-DD。用 `find -mtime`
# 是不行的：轮转文件的 mtime 是「写完那天的 23:59」，不等于文件名里的日期，
# 跨盘挂载或做过备份恢复时 mtime 会被改，删错活跃文件的风险太高。
# launchd / nohup 重定向的原生日志（service.log / proxy.sh.log）不走应用层的
# 按日滚动，只会长不短——cleanup 的日期后缀匹配管不到它们。这里对超过阈值的
# 做 copytruncate：先拷贝归档、再截断当前文件。launchd 持有的 fd 指向 inode，
# 截断后继续追加是安全的；归档名带创建时刻，mtime 就是轮转时刻，下面按
# mtime 清理归档是准确的（与上方「日期文件不能信 mtime」不矛盾：那些的
# mtime 是内容写完的时刻，这里的是我们亲手创建的时刻）。
# 阈值 10MB；cp 失败（如盘满）就不截断，绝不因清理丢数据。
rotate_native_log() {
    local f="$1"
    local bytes
    if stat -f%z "$f" >/dev/null 2>&1; then
        bytes="$(stat -f%z "$f")"                    # BSD/macOS
    else
        bytes="$(stat -c%s "$f" 2>/dev/null || echo 0)"  # GNU
    fi
    (( bytes > 10 * 1024 * 1024 )) || return 0
    local ts
    ts="$(date +%Y%m%d-%H%M%S)"
    if cp "$f" "${f}.${ts}" && : > "$f"; then
        log "已轮转 $(basename "$f")（${bytes} 字节 -> ${f}.${ts}）"
    else
        log "警告: 轮转 $(basename "$f") 失败，保留原文件不动"
    fi
}

cmd_cleanup() {
    local keep="${BUDDY_LOG_KEEP_DAYS:-15}"
    local logdir="$BUDDY_HOME/logs"
    [[ -d "$logdir" ]] || { log "没有 logs 目录（${logdir}）"; return 0; }

    rotate_native_log "$logdir/service.log"
    rotate_native_log "$logdir/proxy.sh.log"

    # 截止日：删除「文件名日期 < 截止日」的轮转文件（保留最近 keep 天）。
    # macOS 与 Linux 的 date 语法不同，各写一支（-v vs -d）。
    local cutoff
    if date -v-"${keep}"d +%Y-%m-%d >/dev/null 2>&1; then
        cutoff="$(date -v-"${keep}"d +%Y-%m-%d)"        # BSD/macOS
    else
        cutoff="$(date -d "-${keep} days" +%Y-%m-%d)"  # GNU
    fi

    local before after n=0
    before="$(du -sh "$logdir" 2>/dev/null | cut -f1)"
    # 逐文件判：尾部 .YYYY-MM-DD 且该日期 < cutoff 才删（字符串比较对
    # 定长 ISO 日期就是字面顺序，不用转 epoch）。
    local f base d
    while IFS= read -r f; do
        base="${f##*/}"
        d="${base##*.}"
        # 只认 YYYY-MM-DD 形状的日期后缀（轮转文件）。BSD find 没有
        # -regextype/-regex，用 -name 通配拿候选、这里再用 case 精确校验形状。
        case "$d" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
            *) continue ;;
        esac
        [[ "$d" < "$cutoff" ]] || continue
        rm -f "$f" && n=$((n + 1))
    done < <(find "$logdir" -maxdepth 1 -type f -name '*.[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' 2>/dev/null)
    # copytruncate 归档（service.log.<时刻> / proxy.sh.log.<时刻>）：mtime 即
    # 轮转时刻，按 mtime 清即可，同样不碰当前活跃文件（无时刻后缀）。
    local r base ts d8 cutoff8
    cutoff8="$(date -v-"${keep}"d +%Y%m%d 2>/dev/null || date -d "-${keep} days" +%Y%m%d)"
    for r in "$logdir"/service.log.* "$logdir"/proxy.sh.log.*; do
        [[ -f "$r" ]] || continue
        base="${r##*/}"
        ts="${base##*.}"
        case "$ts" in
            [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]) ;;
            *) continue ;;
        esac
        d8="${ts%%-*}"
        [[ "$d8" < "$cutoff8" ]] || continue
        rm -f "$r" && n=$((n + 1))
    done
    after="$(du -sh "$logdir" 2>/dev/null | cut -f1)"

    if [[ "$n" -eq 0 ]]; then
        log "无需清理（保留最近 ${keep} 天，截止 ${cutoff}；当前 ${after}）"
    else
        log "已删除 ${n} 个 ${keep} 天前的日志（${before} -> ${after}）"
    fi
}

open_ui() {
    # 「顺手打开管理页」是**尽力而为**，打不开不该让整条命令失败。缺了
    # `|| true` 时 `set -e` 会把失败往外传：无头机器 / 没装浏览器 / `open`
    # 自己报错时，`buddy update` 会在**已经更新成功并重启完**之后以非零退出
    # （CI 上实测 exit 3，日志里 "已更新 -> " "重启服务" 全打完了），
    # 用户看到失败会以为没更成，实际早更完了。xdg-open 那支本来就带了
    # `|| true`，open 这支漏了。
    if command -v open >/dev/null 2>&1; then
        open "$UI_URL" 2>/dev/null || true
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$UI_URL" 2>/dev/null || true
    else
        log "$UI_URL"
    fi
}

# ---------------------------------------------------------------------------
# 自安装到 PATH
# ---------------------------------------------------------------------------

cmd_install() {
    local target_dir target
    if [[ -w /usr/local/bin ]]; then
        target_dir="/usr/local/bin"
    else
        target_dir="$HOME/.local/bin"
        mkdir -p "$target_dir"
    fi
    target="$target_dir/buddy"
    cat > "$target" <<EOF
#!/bin/sh
# generated by 'buddy install' — repo: $BUDDY_HOME
BUDDY_HOME="$BUDDY_HOME"
export BUDDY_HOME
exec "$BUDDY_HOME/buddy" "\$@"
EOF
    chmod +x "$target" "$BUDDY_HOME/buddy"
    log "已安装: $target -> $BUDDY_HOME/buddy"
    case ":$PATH:" in
        *":$target_dir:"*) ;;
        *)
            log "注意: $target_dir 不在 PATH 里，请把下面这行加进 ~/.zshrc："
            log "  export PATH=\"$target_dir:\$PATH\""
            ;;
    esac
    log "之后即可在任意目录使用: buddy start"
}

case "${1:-}" in
    start)        cmd_start ;;
    stop)         cmd_stop ;;
    restart)      cmd_restart ;;
    status)       cmd_status ;;
    logs)         exec "$PROXY_SH" logs ;;
    cleanup)      cmd_cleanup ;;
    login)        shift; exec "$PROXY_SH" login "$@" ;;
    ui)
        if ! curl -sf -o /dev/null "http://127.0.0.1:${PROXY_PORT}/health"; then
            "$PROXY_SH" start || true
        fi
        wait_healthy || true
        open_ui ;;
    service)      shift; cmd_service "$@" ;;
    update)       cmd_update ;;
    install)      cmd_install ;;
    -h|--help|help|"")
        sed -n '/^# buddy - /,/^#   PROXY_HOST/p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        log "未知命令: $1（buddy help 查看用法）"
        exit 1
        ;;
esac
